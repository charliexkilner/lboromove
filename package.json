{
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "4.16.2",
    "@react-google-maps/api": "^2.20.5",
    "@tanstack/react-query": "^5.65.1",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox-gl": "^3.4.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "critters": "^0.0.23",
    "cross-fetch": "^4.1.0",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.5.0",
    "i18next": "^24.2.1",
    "lucide-react": "^0.479.0",
    "mapbox-gl": "^3.10.0",
    "next": "^14.1.0",
    "next-auth": "^4.24.11",
    "next-i18next": "^15.4.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.0",
    "ol": "^10.4.0",
    "react-confetti": "^6.2.2",
    "react-feather": "^2.0.10",
    "react-hot-toast": "^2.5.1",
    "react-i18next": "^15.4.0",
    "react-intersection-observer": "^9.15.0",
    "react-markdown": "^9.0.3",
    "tailwind-scrollbar-hide": "^2.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^0.22.35",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^19.0.7",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.50.1",
    "postcss": "^8.5.1",
    "prisma": "4.16.2",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "scrape": "ts-node --project tsconfig.scraper.json scripts/scrapeProperties.ts",
    "scrape:toplets": "ts-node --project tsconfig.scraper.json scripts/runTopLetsScraper.ts",
    "clear-test": "ts-node -O '{\"module\":\"CommonJS\"}' prisma/clear-test.ts",
    "postinstall": "prisma generate && npm run prisma:fix",
    "verify-prisma": "ts-node --project tsconfig.node.json scripts/verify-prisma.ts",
    "prisma:reset": "rm -rf node_modules/.prisma && prisma generate && next dev",
    "prisma:clean": "rm -rf prisma/generated && prisma generate && prisma db push",
    "db:reset": "prisma migrate reset && prisma generate && prisma db push",
    "prisma:fix": "node ./scripts/fix-prisma.cjs",
    "deduplicate": "ts-node --project tsconfig.node.json scripts/deduplicate-properties.ts",
    "clean-db": "ts-node --project tsconfig.node.json scripts/clean-database.ts",
    "propertyUpdate": "ts-node --project tsconfig.node.json scripts/post-scrape-updates.ts",
    "verifyData": "ts-node --project tsconfig.node.json scripts/verify-property-data.ts",
    "test:playwright": "ts-node --project tsconfig.scraper.json scripts/test-playwright.ts",
    "test:toplets": "ts-node --project tsconfig.scraper.json scripts/test-toplets.ts",
    "test:toplets-api": "ts-node --project tsconfig.scraper.json scripts/test-toplets-api.ts",
    "scrape:all": "ts-node --project tsconfig.scraper.json scripts/scrapeProperties.ts",
    "update:toplets": "ts-node --project tsconfig.node.json scripts/update-toplets-property-details.ts",
    "fix:toplets-streets": "ts-node --project tsconfig.node.json scripts/fix-toplets-streets-coordinates.ts",
    "fix:toplets-streets-ors": "ts-node --project tsconfig.node.json scripts/fix-toplets-streets-ors.ts",
    "update:toplets-walking": "ts-node --project tsconfig.node.json scripts/update-toplets-walking-distances.ts",
    "fix:toplets-photos": "ts-node --project tsconfig.node.json scripts/fix-toplets-photos.ts",
    "fix:toplets-walking-times": "ts-node --project tsconfig.node.json scripts/fix-toplets-walking-times.ts",
    "fix:all-walking-times": "ts-node --project tsconfig.node.json scripts/fix-all-walking-times.ts",
    "verify:distances": "ts-node --project tsconfig.node.json scripts/verify-walking-distances.ts",
    "fix:distances": "ts-node --project tsconfig.node.json scripts/verify-walking-distances-ors.ts --fix",
    "verify:distances-ors": "ts-node --project tsconfig.node.json scripts/verify-walking-distances-ors.ts",
    "fix:distances-ors": "ts-node --project tsconfig.node.json scripts/verify-walking-distances-ors.ts --fix"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "engines": {
    "node": "18.x"
  }
}
