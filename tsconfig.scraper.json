{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true
  },
  "include": ["scripts/**/*.ts", "lib/**/*.ts", "utils/**/*.ts"],
  "exclude": ["node_modules"]
}
