generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String             @id @default(cuid())
  firstName          String
  lastName           String
  email              String?            @unique
  emailVerified      DateTime?
  image              String?
  role               UserRole           @default(STUDENT)
  studyYear          StudyYear?
  isVerifiedLandlord Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  accounts           Account[]
  collections        Collection[]
  memberOf           CollectionMember[]
  comments           Comment[]
  commentVotes       CommentVote[]
  posts              DiscussionPost[]
  favorites          Favorite[]
  postVotes          PostVote[]
  properties         Property[]         @relation("LandlordProperties")
  recentlyViewed     RecentlyViewed[]
  savedSearches      SavedSearch[]
  sessions           Session[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  houseId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, houseId])
}

model Property {
  id               Int                  @id @default(autoincrement())
  title            String
  price            Float
  rooms            Int
  bathrooms        Int
  images           String[]
  description      String?
  location         String
  amenities        String[]
  scrapedFrom      String
  externalId       String
  hash             String               @unique
  url              String?
  keyFeatures      Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  landlordId       String?
  bathroomType     String?
  catering         String?
  distanceToCampus Float?
  distanceToTown   Float?
  isGoldenTriangle Boolean              @default(false)
  isNearCampus     Boolean              @default(false)
  latitude         Float?
  longitude        Float?
  maxPrice         Float?
  priceRange       String?
  pricingOptions   String[]             @default([])
  source           String?
  street           String?
  emoji            String?
  collections      CollectionProperty[]
  landlord         User?                @relation("LandlordProperties", fields: [landlordId], references: [id])
  viewedBy         RecentlyViewed[]

  @@unique([title, price, rooms, location], name: "property_unique")
}

model ScrapingLog {
  id           String    @id @default(uuid())
  website      String
  status       String
  message      String?
  startTime    DateTime  @default(now())
  endTime      DateTime?
  itemsScraped Int       @default(0)

  @@index([website, startTime])
}

model RecentlyViewed {
  id         String   @id @default(cuid())
  userId     String
  propertyId Int
  viewedAt   DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  filters   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Collection {
  id          String               @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User                 @relation(fields: [createdById], references: [id])
  members     CollectionMember[]
  properties  CollectionProperty[]
}

model CollectionMember {
  id           String     @id @default(cuid())
  collectionId String
  userId       String
  joinedAt     DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
}

model CollectionProperty {
  id           String     @id @default(cuid())
  collectionId String
  propertyId   Int
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([collectionId, propertyId])
}

model DiscussionPost {
  id          String     @id @default(cuid())
  title       String
  content     String
  category    String     @default("general")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    String
  isAnonymous Boolean    @default(false)
  imageUrl    String?
  comments    Comment[]
  author      User       @relation(fields: [authorId], references: [id])
  votes       PostVote[]
}

model Comment {
  id        String         @id @default(cuid())
  content   String
  authorId  String
  postId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  author    User           @relation(fields: [authorId], references: [id])
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes     CommentVote[]
}

model PostVote {
  id     String         @id @default(cuid())
  postId String
  userId String
  value  Int            @db.SmallInt
  post   DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model CommentVote {
  id        String  @id @default(cuid())
  commentId String
  userId    String
  value     Int     @db.SmallInt
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model CampusProperty {
  id             Int      @id @default(autoincrement())
  title          String
  url            String
  imageUrl       String
  priceRange     String
  minPrice       Float
  maxPrice       Float
  pricingOptions String[]
  location       String
  catering       String
  bathroomType   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum UserRole {
  STUDENT
  LANDLORD
  ADMIN
}

enum StudyYear {
  FIRST_YEAR
  SECOND_YEAR
  FINAL_YEAR
  MASTERS
  PHD
  PLACEMENT_YEAR
}
